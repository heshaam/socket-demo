# Copy to .env and never commit. Confirm actual endpoint/flags in current Socket docs.
SOCKET_ORG_SLUG=replace-me
SOCKET_TOKEN=replace-me
# Exact full-scan REST URL from Socket API documentation; no assumed API path.
SOCKET_FULL_SCAN_URL=
# Optional endpoint for inspecting token quota, if documented.
SOCKET_QUOTA_URL=
# Full CLI command with explicit manifest/workspace targeting (not executed via eval).
# Example ONLY after confirming supported flags: socket scan ...
SOCKET_CLI_COMMAND=
# Registry-mode image reference from Socket's official Firewall documentation.
SOCKET_FIREWALL_IMAGE=
# Socket-specific registry-mode configuration: configure per official documentation.
SOCKET_FIREWALL_PORT=4873
# The client-visible registry URL (must be a working Socket Firewall proxy).
SOCKET_FIREWALL_REGISTRY=http://127.0.0.1:4873/
